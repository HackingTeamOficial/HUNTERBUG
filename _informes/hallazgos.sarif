                  "target": {
                    "id": "CWE-538",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "FUG-08",
              "name": "FUG08",
              "shortDescription": {
                "text": "Actuator /env expuesto accesible"
              },
              "fullDescription": {
                "text": "Muestra variables de entorno, incluidas credenciales"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "critico",
