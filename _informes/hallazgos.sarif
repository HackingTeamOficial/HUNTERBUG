                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "CKI-01",
              "name": "CKI01",
              "shortDescription": {
                "text": "1 cookie(s) sin secure"
              },
              "fullDescription": {
                "text": "La cookie viaja tambien por HTTP sin cifrar y puede ser interceptada"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "alto",
                "categoria": "cookies",
                "tool": "HunterBug 1.1",
                "cwe": "CWE-614",
                "owasp": "A05:2021"
              },
              "help": {
                "text": "Anadir el atributo Secure a todas las cookies de sesion"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-614",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "CKI-02",
              "name": "CKI02",
              "shortDescription": {
                "text": "1 cookie(s) sin httponly"
              },
              "fullDescription": {
                "text": "Sin HttpOnly el JavaScript de la pagina puede leer la cookie, lo que convierte cualquier XSS en robo de sesion"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "alto",
                "categoria": "cookies",
                "tool": "HunterBug 1.1",
                "cwe": "CWE-1004",
                "owasp": "A05:2021"
              },
              "help": {
                "text": "Anadir HttpOnly a las cookies de sesion"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-1004",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "CON-03",
              "name": "CON03",
              "shortDescription": {
                "text": "2 posible(s) secreto(s) en el cliente"
              },
              "fullDescription": {
                "text": "Claves o tokens embebidos en el HTML o el JS son visibles para cualquiera"
              },
              "defaultConfiguration": {
                "level": "error"
