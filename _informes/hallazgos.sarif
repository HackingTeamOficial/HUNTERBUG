                "tool": "HunterBug 1.1",
                "cwe": "CWE-530",
                "owasp": "A05:2021"
              },
              "help": {
                "text": "Retirar las copias del directorio web"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-530",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "PAR-01",
              "name": "PAR01",
              "shortDescription": {
                "text": "Inyeccion SQL (basada en errores) en 'q'"
              },
              "fullDescription": {
                "text": "El parametro 'q' refleja un error de MySQL al inyectar \"'\""
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "critico",
                "categoria": "parametros",
                "tool": "HunterBug 1.1",
                "cwe": "CWE-89",
                "owasp": "A03:2021"
              },
              "help": {
                "text": "Usar consultas parametrizadas (prepared statements) y validacion estricta de entrada."
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-89",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "PAR-17",
              "name": "PAR17",
              "shortDescription": {
                "text": "Inyeccion de comandos en 'q'"
              },
              "fullDescription": {
                "text": "El comando enviado aparece en la salida"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "critico",
