                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "CON-10",
              "name": "CON10",
              "shortDescription": {
                "text": "Formulario de contrasena con method=GET"
              },
              "fullDescription": {
                "text": "La contrasena queda en la URL, en el historial y en los registros del servidor"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "alto",
