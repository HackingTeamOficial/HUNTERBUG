              "name": "FUG10",
              "shortDescription": {
                "text": "Consola expuesta accesible"
              },
              "fullDescription": {
                "text": "Una consola interactiva expuesta permite ejecucion de codigo"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
