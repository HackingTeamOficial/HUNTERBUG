                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "CRS-04",
              "name": "CRS04",
              "shortDescription": {
                "text": "CORS acepta el origen null"
              },
              "fullDescription": {
                "text": "El origen null procede de iframes sandbox o ficheros locales y no deberia autorizarse"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "alto",
                "categoria": "cors",
                "tool": "HunterBug 1.1",
                "cwe": "CWE-942",
                "owasp": "A05:2021"
              },
              "help": {
                "text": "Rechazar explicitamente el origen null"
