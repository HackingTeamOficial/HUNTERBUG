                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "CRS-02",
              "name": "CRS02",
              "shortDescription": {
                "text": "CORS refleja cualquier Origin enviado"
              },
              "fullDescription": {
                "text": "El servidor devuelve el origen solicitado sin validarlo, lo que permite leer respuestas desde cualquier web"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "alto",
                "categoria": "cors",
                "tool": "HunterBug 1.1",
                "cwe": "CWE-942",
                "owasp": "A05:2021"
              },
              "help": {
                "text": "Validar el Origin contra una lista blanca"
