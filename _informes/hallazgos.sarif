{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "HunterBug",
          "fullName": "HunterBug 1.1",
          "version": "1.1",
          "informationUri": "https://github.com/HackingTeamOficial/HUNTERBUG",
          "rules": [
            {
              "id": "CRS-03",
              "name": "CRS03",
              "shortDescription": {
                "text": "CORS con credenciales y origen reflejado"
              },
              "fullDescription": {
                "text": "Con Allow-Credentials true y el Origin reflejado, cualquier web puede leer respuestas con la sesion del usuario"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "critico",
                "categoria": "cors",
                "tool": "HunterBug 1.1",
                "cwe": "CWE-942",
                "owasp": "A05:2021"
              },
              "help": {
                "text": "Lista blanca estricta de origenes y Vary: Origin"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-942",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "FUG-01",
              "name": "FUG01",
              "shortDescription": {
                "text": "Repositorio Git expuesto accesible"
              },
              "fullDescription": {
                "text": "Permite reconstruir el codigo fuente completo"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "critico",
                "categoria": "rutas",
                "tool": "HunterBug 1.1",
                "cwe": "CWE-538",
                "owasp": "A01:2021"
              },
              "help": {
                "text": "Bloquear el acceso a .git desde el servidor web"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-538",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "FUG-02",
              "name": "FUG02",
              "shortDescription": {
                "text": "Fichero .env expuesto accesible"
              },
              "fullDescription": {
                "text": "Contiene credenciales, claves y configuracion de la aplicacion"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "critico",
                "categoria": "rutas",
